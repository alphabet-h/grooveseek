# KB-on-NAS deployment — config for a machine that also EDITS the KB
#
# Same shape as kb-mcp.toml.client; the difference is the watcher
# discussion below. Every machine still keeps its own index on local disk.
# See README.md / README.ja.md.

# Mount point for the NAS share, mounted read-write on this machine since
# it edits the KB. The parent must be on LOCAL disk: .kb-mcp.db is created
# at <kb_path>/../.kb-mcp.db and must not live on the share.
kb_path = "/var/lib/kb-mcp/knowledge-base"

model = "bge-m3"

reranker = "bge-v2-m3"
rerank_by_default = false

# Keep the model cache on local disk (fast); never point this at the NAS.
fastembed_cache_dir = "/var/cache/fastembed"

[parsers]
enabled = ["md"]

# Watcher: OFF by default here too, because a network mount does not
# deliver filesystem events. If this machine edits the KB through the
# mount, its own writes are also invisible to the watcher — the events
# would have to come from the NAS, not from the local kernel. The timer is
# what keeps the index fresh; set this to true only if you have a local
# copy of the files rather than a mount.
[watch]
enabled = false

[quality_filter]
enabled = true
threshold = 0.3
