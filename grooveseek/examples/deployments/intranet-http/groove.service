# /etc/systemd/system/groove.service
#
# systemd unit for the intranet HTTP deployment. See README.md / README.ja.md
# for full setup. Enable with:
#     sudo cp groove.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now groove.service

[Unit]
Description=groove Streamable HTTP MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=groove
Group=groove

# The index, the database and the config all live here.
WorkingDirectory=/srv/groove

# `--config` names the file instead of letting discovery find it, and naming it
# is what makes it *trusted*. A config groove only discovers — from the working
# directory, or from a .git ancestor — has `fastembed_cache_dir`,
# `allowed_hosts`, `allowed_origins` and a non-loopback `bind` stripped out of
# it, because a file found that way is one anyone who can write to the
# directory could have put there.
#
# Discovered, this unit would therefore ignore the `fastembed_cache_dir` in
# groove.toml and fall back to the OS cache directory — which `ProtectSystem`
# and `ProtectHome` below make unwritable, since `ReadWritePaths=` grants the
# one path the config names. The model download fails, and nothing about the
# error says the config was the reason.
#
# See "Trusted and untrusted config locations" in docs/configuration.md.
ExecStart=/usr/local/bin/groove serve --config /srv/groove/groove.toml

# Restart on transient failures (network blips, OOM kills, etc.).
Restart=on-failure
RestartSec=5s

# Resource hardening. Tighten further on production hosts.
# groove needs no privileged operations, no inbound device access.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true

# Read-write paths groove legitimately needs:
#   - /srv/groove/    : kb_path itself + .groove.db (the parent of kb_path)
#   - /var/cache/fastembed : ONNX model cache (matches `fastembed_cache_dir` in groove.toml)
ReadWritePaths=/srv/groove /var/cache/fastembed

# RUST_LOG controls verbosity. info gives the "loaded config source=..." startup
# line plus warnings; bump to debug for troubleshooting.
Environment=RUST_LOG=info

# stdout/stderr go to the journal — `journalctl -u groove.service -f` to tail.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
