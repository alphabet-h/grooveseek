# KB-on-NAS deployment — config for a machine that also EDITS the KB
#
# Same shape as groove.toml.client; the difference is the watcher
# discussion below. Every machine still keeps its own index on local disk.
# See README.md / README.ja.md.

# Mount point for the NAS share, mounted read-write on this machine since
# it edits the KB. The parent must be on LOCAL disk: .groove.db is created
# at <kb_path>/../.groove.db and must not live on the share.
kb_path = "/var/lib/groove/knowledge-base"

model = "bge-m3"

reranker = "bge-v2-m3"
rerank_by_default = false

# Model cache: local disk, and writable by the account that runs groove.
# Kept inside the same user-owned tree as the database so setup creates it
# once. Omit the key entirely to use the OS cache dir (~/.cache/fastembed on
# Linux) — but not if home directories are themselves on the NAS.
fastembed_cache_dir = "/var/lib/groove/fastembed"

[parsers]
enabled = ["md"]

# Watcher: OFF by default here too, because a network mount does not
# deliver filesystem events. If this machine edits the KB through the
# mount, its own writes are also invisible to the watcher — the events
# would have to come from the NAS, not from the local kernel. The timer is
# what keeps the index fresh; set this to true only if you have a local
# copy of the files rather than a mount.
[watch]
enabled = false

[quality_filter]
enabled = true
threshold = 0.3
