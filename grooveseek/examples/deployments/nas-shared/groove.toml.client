# KB-on-NAS deployment — per-machine config (groove.toml)
#
# Every machine uses this and keeps its own index. See README.md /
# README.ja.md for why the database must not live on the share.

# Mount point for the NAS share. The parent directory has to be on LOCAL
# disk, because .groove.db is created at <kb_path>/../.groove.db — here
# that is /var/lib/groove/.groove.db, private to this machine.
kb_path = "/var/lib/groove/knowledge-base"

# Multilingual model (BGE-M3) is usually the right choice for shared KBs
# that mix English / Japanese / project notes. Switch back to bge-small-en-v1.5
# if your KB is English-only and you want a 6× smaller download.
model = "bge-m3"

# Reranker is optional and local: the CPU cost lands on whichever machine
# runs the search, so it can differ per machine. Comment out to skip the
# ~2.3 GB download.
reranker = "bge-v2-m3"
rerank_by_default = false

# Model cache: local disk, and writable by the account that runs groove.
# Kept inside the same user-owned tree as the database so setup creates it
# once. Omit the key entirely to use the OS cache dir (~/.cache/fastembed on
# Linux) — but not if home directories are themselves on the NAS.
fastembed_cache_dir = "/var/lib/groove/fastembed"

[parsers]
enabled = ["md"]

# Watcher OFF: neither inotify (Linux) nor ReadDirectoryChangesW (Windows)
# propagates over a network filesystem, so it would silently miss every
# edit made from another machine. A systemd timer drives `groove index`
# instead — see the README.
[watch]
enabled = false

[quality_filter]
enabled = true
threshold = 0.3
