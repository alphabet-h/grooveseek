# Sample frontmatter schema for groove.
#
# Copy this to `<kb-path>/groove-schema.toml` to switch validation on. With no
# schema file present, `groove validate` reports "no schema found" and exits 0
# — the same result as never having enabled validation.
#
# Per-field constraints:
#   required      : true means a missing value, an empty string, or an empty
#                   array counts as a violation
#   type          : "string" / "array"
#   pattern       : regular expression (Rust `regex` syntax), matched against a
#                   string field or against every element of an array field,
#                   one violation per element that does not match. It matches
#                   anywhere in the value, so anchor it with ^ and $. Write it
#                   as a TOML literal string in single quotes so backslashes do
#                   not need doubling
#   enum          : allowed values, compared exactly against a string field or
#                   against every element of an array field
#   min_length    : characters for a string, elements for an array
#   max_length    : characters for a string, elements for an array
#   allow_empty   : opt-in; permits an empty value even where required = true
#
# `type = "integer"` and `type = "date"` parse, but the schema REFUSES to
# compile with either. Frontmatter is held as strings throughout, so neither is
# implemented, and accepting them quietly would mean validating nothing.
# Express a date as a string with a pattern, the way `[fields.date]` does below.
#
# Only `.md` files are checked; `.txt` has no frontmatter and is skipped.
# A `.md` whose `---` block is not valid YAML is reported as one
# `frontmatter_unparsed` violation carrying the parser's reason; the rules
# below are not applied to it.
# Field names other than title / date / topic / depth / tags are refused.

[fields.title]
required = true
type = "string"
min_length = 1

[fields.date]
required = true
type = "string"
pattern = '^\d{4}-\d{2}-\d{2}$'   # ISO-8601 date

[fields.topic]
required = true
type = "string"
enum = ["mcp", "rag", "ai", "tooling", "ops"]

# optional: the enum applies only when depth is present
[fields.depth]
required = false
type = "string"
enum = ["1", "2", "3"]

[fields.tags]
required = true
type = "array"
min_length = 1
max_length = 10
# pattern = '^[a-z0-9-]+$'   # every element must match; the tag
#                            # `frontmatter:unparsed` never reaches this rule
