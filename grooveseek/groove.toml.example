# Example groove configuration.
#
# Copy this file to `groove.toml` and edit. Every key is optional: omitting one
# keeps the built-in default, and an explicit CLI argument always wins over the
# file. Unknown keys are rejected at startup so typos surface immediately.
#
# Placement — `groove` looks for `groove.toml` in this order and stops at the
# first hit:
#
#   1. `--config <PATH>` (any subcommand; errors out if the file is missing)
#   2. the current working directory
#   3. the nearest `.git` ancestor of the working directory (up to 20 levels)
#   4. the directory holding the `groove` binary
#
# The project root (2) and next to the binary (4) are the common choices. See
# "Config file discovery" in docs/configuration.md for the full rules.
#
# NOTHING HERE CHANGES BEHAVIOUR AS SHIPPED. Every value left uncommented below
# is already the built-in default, and everything that would alter how groove
# behaves is commented out — so a fresh copy is inert, and what you turn on is
# what you meant to turn on.

# Absolute path to the knowledge-base directory. Set it to stop passing
# `--kb-path` on every invocation.
#kb_path = "/path/to/knowledge-base"

# Default embedding model.
#   bge-small-en-v1.5 … English-focused, 384 dim, ~130 MB (the default)
#   bge-m3            … multilingual (incl. Japanese), 1024 dim, ~2.3 GB
# Changing this requires `groove index --force`: the index stores vectors of one
# model's dimensionality, and `serve` refuses to start on a mismatch.
#model = "bge-m3"

# Default cross-encoder reranker.
#   none       … disabled (the default)
#   bge-v2-m3  … BAAI/bge-reranker-v2-m3 (multilingual, ~2.3 GB; recommended for Japanese)
#   jina-v2-ml … jinaai/jina-reranker-v2-base-multilingual (~1.2 GB, lighter multilingual)
#   bge-base   … BAAI/bge-reranker-base (English/Chinese, ~280 MB)
# Index-independent: switching rerankers does not require re-indexing.
#reranker = "bge-v2-m3"

# Whether every `search` call reranks automatically once a reranker is
# configured. Read by `groove serve` and by `groove search` alike (v0.27.0+).
# Takes a boolean rather than being a bare flag, so the CLI form is
# `--rerank-by-default=false`. To override it for a single query: the MCP tool's
# `rerank` parameter, or naming a model with `--reranker` on the command line
# (`--reranker none` opts out for that one query).
#rerank_by_default = true

# fastembed model cache directory. The environment variable
# `FASTEMBED_CACHE_DIR`, when set, wins over this key — note the spelling
# difference: the file key is lower-case, and the upper-case name works only in
# a real environment. Point it at a HuggingFace Hub cache you populated with
# `hf download` to work around environments where fastembed's own TLS download
# fails.
#fastembed_cache_dir = "/path/to/.cache/huggingface/hub"

# Heading substrings to exclude when chunking Markdown. Omitted, nothing is
# excluded. A heading containing any of these substrings loses its whole
# section, but descendants keep their correct ancestry breadcrumb.
#exclude_headings = ["Further reading", "参考リンク"]

# Directory basenames skipped while indexing. Whole-name match, not substring
# or glob. Omitted, the default is
# [".obsidian", ".git", "node_modules", "target", ".vscode", ".idea"].
# A list here REPLACES that default rather than adding to it, and an empty list
# traverses everything.
#exclude_dirs = [".obsidian", ".git", "node_modules", "target", ".vscode", ".idea", "dist", ".next"]

# To exclude individual files or glob patterns rather than whole directories,
# put a `.grooveignore` in the ROOT of the knowledge base. It uses gitignore
# syntax and there is no setting for it here:
#
#     drafts/
#     *.tmp.md
#     archive/**
#     notes/*.md
#     !notes/keep.md
#
# It combines with exclude_dirs as a union, so `!` only undoes an earlier line
# of that same file. Like exclude_dirs, it bounds what gets INDEXED — an
# excluded file never appears in search, but get_document still returns it to a
# caller that knows its path. Keep anything that must not be readable outside
# kb_path. See ".grooveignore" in docs/behavior.md.

# --- [quality_filter] — per-chunk quality filter --------------------------
# On by default with threshold 0.3, which is what the two lines below spell
# out. Chunks scoring below the threshold are dropped from MCP search, CLI
# search and get_connection_graph. Turn the filter off to return every chunk
# regardless of score.
[quality_filter]
enabled = true
threshold = 0.3

# --- [best_practice] — the `get_best_practice` MCP tool (opt-in) ----------
# The tool stays DISABLED until this section lists at least one template:
# without one it answers with a "not configured" error, which is the shipped
# state. Templates are tried in order, `{target}` substituted, resolved
# relative to kb_path; the first existing file wins. The `target` argument is
# canonicalized and confined to kb_path.
[best_practice]
#path_templates = ["best-practices/{target}/PERFECT.md", "docs/{target}.md"]

# --- [parsers] — which file extensions get indexed ------------------------
# Three-state semantics:
#   - section absent      … Markdown only, same as the line below
#   - explicit empty list … rejected at startup, so that "nothing is indexed"
#                           cannot happen silently
#   - explicit list       … exactly those extensions
# Supported ids: "md", "txt", "pdf" (v0.10.0+), "docx", "xlsx", "pptx"
# (v0.11.0+). Unknown ids such as "rst" or "adoc" are rejected at startup.
# "xls" was withdrawn in v0.14.0 and is rejected with an explanation: BIFF
# bounds a sheet but not a workbook, so a small file declaring many sheets can
# exhaust memory. Convert such a workbook to `.xlsx`, which is read as a stream.
# Known limitations (PDF: no OCR, multi-column reading order; Office: no legacy
# .doc/.ppt/.xls, no OpenDocument, password-protected files are detected and
# skipped, tables are flattened to plain text) are described in docs/behavior.md.
[parsers]
enabled = ["md"]
# (everything this build supports: enabled = ["md", "txt", "pdf", "docx", "xlsx", "pptx"])

# --- [watch] — live-sync file watcher ------------------------------------
# Active during `groove serve` only. Detects changes, additions, deletions and
# renames under kb_path and re-indexes just the affected files, which covers
# manual edits, `git pull` and external scripts. The two lines below are the
# defaults; `--no-watch` and `--debounce-ms <ms>` override them per run.
[watch]
enabled = true
debounce_ms = 500

# --- [transport] — how `groove serve` listens ----------------------------
# "stdio" (the default, below) serves one client at a time over the process's
# own stdin/stdout. "http" serves many simultaneous clients over Streamable
# HTTP, mounted at /mcp, with /healthz answering 200 for probes.
#
# CHANGING THE LINE BELOW TO "http" OPENS A LISTENING SOCKET. So does deleting
# the `kind` line while leaving the [transport.http] section in place — an
# explicit [transport.http] means http on its own. `--transport http --port
# 3100` and `--bind 0.0.0.0:3100` override per run.
[transport]
kind = "stdio"

[transport.http]
# Ignored while kind stays "stdio". The default is loopback, which is what the
# line below repeats. Note the asymmetry once you do switch to http: a
# non-loopback `--bind` on the COMMAND LINE is refused unless you add
# `--i-know`, whereas a non-loopback address set HERE is not gated, because a
# config file is taken as a deliberate deployment decision. groove ships NO
# authentication of its own, so before exposing it to anything untrusted, set
# `allowed_hosts` below and put a reverse proxy that does authenticate in front
# of it.
bind = "127.0.0.1:3100"

# Allow-list of accepted Host headers (DNS-rebinding defence, v0.5.0+).
# Omitted, rmcp's default of localhost / 127.0.0.1 / ::1 (loopback only)
# applies. ALWAYS set this explicitly when exposing the server on a LAN:
# binding 0.0.0.0 while the allow-list stays loopback-only means every external
# request is rejected with 403 by Host validation, which is almost always an
# operator mistake, so startup warns about it. An empty list allows EVERY Host,
# equivalent to disabling the check, and warns for the same reason.
# IPv6 entries: the bracketed form "[::1]" is clearer, and the bare "::1" is
# also accepted for backward compatibility.
# If you also open /ui on the server, keep the loopback names here: /ui searches
# by calling /mcp, Host validation runs before Origin validation, and a list of
# only public names refuses the `Host: localhost` the page sends. The startup
# log warns when this list would break it.
#allowed_hosts = ["kb.example.lan", "192.168.1.10", "192.168.1.10:3100", "localhost", "127.0.0.1"]

# Allow-list of accepted browser Origin headers. This covers /mcp -- and /ui
# searches by calling /mcp, so this key decides whether the built-in page can
# query. Replace the default with only a public origin and /ui is still served
# while every search it makes is refused; the server warns about that
# combination at startup. /api/admin/status carries no Origin check of its own;
# what restricts it is that the peer must be loopback, which is not
# configurable.
# Omitted, the loopback origins for the bind port apply -- http://localhost:PORT,
# http://127.0.0.1:PORT and http://[::1]:PORT -- plus the bound address itself
# when that is some other loopback address, since all of 127.0.0.0/8 is loopback
# and a browser opening 127.0.0.2 sends that as its Origin. The MCP
# specification requires servers to validate Origin to prevent DNS rebinding, so
# unlike allowed_hosts this one is NOT off by default.
# Set it when a browser-based client reaches the server through something else:
# behind a reverse proxy the browser sends your PUBLIC origin, not a loopback
# one, and the default list will not match it. Entries need a scheme, and IPv6
# must be bracketed, because both are compared as RFC 6454 (scheme, host, port)
# triples.
# This is NOT authentication: a request with no Origin header at all -- every
# ordinary MCP client, the tray, curl -- passes regardless. What it stops is a
# web page open in your browser reaching /mcp cross-origin.
# Setting this REPLACES the default list, it does not add to it, so keep the
# loopback entries alongside your public origin if browser clients also reach
# you over loopback.
# An empty list DISABLES validation entirely and warns at startup.
#allowed_origins = ["https://kb.example.com", "http://127.0.0.1:3100", "http://localhost:3100"]

# Whether /healthz sits outside the allow-list (v0.7.5+). The default is public,
# with no Host check. Turn it off to have /healthz validated like every other
# endpoint, so a request whose Host header is not on the allow-list gets 403
# instead of 200. This is NOT authentication: the Host header is chosen by the
# caller, so anyone who reaches the port and sends an allowed value still gets a
# 200. It raises the bar for incidental probes, nothing more.
#healthz_public = false

# How many MCP sessions may be alive at once (v0.19.0+). The default is 256,
# which is roughly 25 MB: a live session costs about 100 KB. While the limit is
# full, a request that would open a NEW session is answered with 429 and a
# Retry-After header; established sessions keep working. Sessions are released
# when a client disconnects, and otherwise after rmcp's 5-minute idle timeout,
# so a client that reconnects in a loop can hold slots for a while. Set 0 to
# disable the limit entirely.
#
# This only concerns clients speaking MCP 2025-11-25 or older. The 2026-07-28
# protocol has no sessions at all (SEP-2567): those requests are served
# statelessly, hold nothing, and are never refused by this limit.
#max_sessions = 256

# --- [eval] — retrieval quality evaluation (power-user, optional) ---------
# Only needed if you run `groove eval`. See docs/eval.md. The commented values
# are the built-in defaults.
[eval]
#golden = ".groove-eval.yml"    # default: <kb_path>/.groove-eval.yml
#history_size = 10              # default: 10
#k_values = [1, 5, 10]          # default: [1, 5, 10]
#regression_threshold = 0.05    # diff highlighting threshold (default: 0.05)

# --- [search] — search tool tuning (v0.3.0+) -----------------------------
# Rank-based low-confidence flag: it trips when the top hit's score divided by
# the mean of the top-N scores falls below the ratio. Zero disables the flag.
# CLI `--min-confidence-ratio` and the MCP `min_confidence_ratio` parameter
# override per query.
[search]
#min_confidence_ratio = 1.5     # default: 1.5

# Maximal Marginal Relevance: post-rerank diversity correction, applied AFTER
# the reranker and BEFORE the parent retriever. Off by default. See
# docs/retrieval-pipeline.md.
[search.mmr]
#enabled = false
#lambda = 0.7              # 1.0 means no diversity (equivalent to off); below 0.5 leans exploration
#same_doc_penalty = 0.0    # above 0 deduplicates same-document chunks; 0 is pure MMR

# RRF constant and FTS5 bm25 column weights. The commented values are the
# built-in defaults, so leaving this section alone changes nothing. Only touch
# them after measuring with `groove tune` on your own KB — the defaults are the
# industry convention and RRF is documented as needing no tuning.
[search.fusion]
#rrf_k = 60.0                  # at least 1.0. Lower favours one retriever's top hit over consensus
#bm25_heading_weight = 2.0     # bm25 column weight for the chunk heading
#bm25_context_weight = 1.0     # bm25 column weight for the static context prefix
#bm25_content_weight = 1.0     # bm25 column weight for the chunk body

# Display-time content expansion for hit chunks (v0.7.0+). Off by default. When
# enabled, a short hit is expanded to adjacent siblings or the whole document so
# the LLM gets enough context. Score, rank and match_spans of the original hit
# are preserved; only the content and the new expanded_from field change. See
# docs/retrieval-pipeline.md.
[search.parent_retriever]
#enabled = false
#whole_doc_threshold_tokens = 100   # token_count below this falls back to the whole document
#max_expanded_tokens = 2000         # cap for adjacent merge and whole-doc (BGE-M3 supports up to 8192)

# --- [contextual] — static Contextual Retrieval (v0.12.0+) ---------------
# Injects the parser-generated context breadcrumb (document title plus heading
# path) into the embedding, FTS and reranker inputs. Off by default, and that
# default is measured rather than conservative: on a 574-document dogfood KB,
# turning it on WITHOUT a reranker made recall@5 and MRR worse. Combined with a
# reranker such as bge-v2-m3 it was best on every metric (recall@5 +0.047,
# MRR +0.102), so enable it only when a reranker is configured too. Details are
# in the "Contextual Retrieval" section of docs/usage.md.
# Applying it to an existing index needs `groove index --force`: the built mode
# is recorded in index_meta.context_mode, and without --force a mismatch only
# warns and keeps the DB's current mode.
# [contextual]
# enabled = true
